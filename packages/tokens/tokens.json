      "700": "#2f3a92"
    },
    "accent": {
      "500": "#e0761f",
      "600": "#b95c14"
    },
    "neutral": {
      "0":   "#ffffff",
      "50":  "#f7f7f6",
      "100": "#eeeeec",
      "200": "#dcdcd8",
      "400": "#9a9a96",
      "600": "#5e5e5c",
      "800": "#2a2b30",
      "900": "#17181c"
