# What a deployment needs, in one file.
#
#   cp .env.production.example .env.production
#
# Read by ops/docker/compose.prod.yml: the API containers take it as their
# .env, and the site and console read the addresses out of it. Never committed
# — .dockerignore and .gitignore both keep it out, because it holds every
# credential this platform has.
#
# See docs/DEPLOYMENT.md for what runs and why.
#
# The blanks below are not optional. The migration and php-fpm run
# `php artisan app:preflight` before they start, and the worker and the
# scheduler check the same list; with APP_ENV=production each stops — naming
# each variable to fix — if APP_KEY, a gateway key or webhook secret, the mail
# settings, the text settings or TRUSTED_PROXIES are missing or only pretend.
# Other artisan commands still run, so a box can be put right. To check a
# filled-in copy before starting anything:
#
#   docker compose --env-file .env.production -f ops/docker/compose.prod.yml \
#     run --rm --no-deps api php artisan app:preflight

# --- the application ------------------------------------------------------------
APP_NAME=myFiesta
APP_ENV=production
# php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.myfiesta.ca

# --- what is in front of it --------------------------------------------------------
# The addresses the load balancer connects from, as the API's nginx sees them:
# comma-separated addresses or CIDR ranges. Only these may say who a visitor
# is (X-Forwarded-For) or that they came over https (X-Forwarded-Proto); from
# anybody else both are ignored. Read by the API and by its nginx, and neither
# starts without it or with a wildcard. With the load balancer on the same host
# as the containers, it is the compose network's gateway address — and then
# only with API_BIND left at 127.0.0.1 (below): anything reaching a public
# port through Docker's proxy arrives from the gateway too. With the load
# balancer on another machine, it is that machine's address, never the gateway.
TRUSTED_PROXIES=

# Where the two front ends live. The API builds links into emails from these,
# so a wrong one sends buyers somewhere that does not exist.
PUBLIC_URL=https://myfiesta.ca
CONSOLE_URL=https://console.myfiesta.ca

# Every origin that may call this API, including the two a Capacitor app
# reports. An origin missing here is a browser refusing every request with an
# error that says nothing about why.
CORS_ALLOWED_ORIGINS=https://myfiesta.ca,https://www.myfiesta.ca,https://console.myfiesta.ca,https://localhost,capacitor://localhost

# --- the addresses the front ends are told at run time -----------------------------
# The same values again, for the site and console containers. Nothing is
# compiled into either bundle, so one build serves staging and production.
API_BASE_URL=https://api.myfiesta.ca
SITE_HOSTS=myfiesta.ca,www.myfiesta.ca

# --- data --------------------------------------------------------------------------
# Postgres 17. Not negotiable: generated columns, partial unique indexes, check
# constraints and an append-only trigger on the ledger.
DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=myfiesta
DB_USERNAME=
DB_PASSWORD=

REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=

QUEUE_CONNECTION=redis
CACHE_STORE=redis
SESSION_DRIVER=redis

# Private files — identity documents, data exports. A volume that survives a
# redeploy, or object storage. Never the image.
FILESYSTEM_DISK=local

# --- uploaded pictures -------------------------------------------------------------
# Posters, logos and gallery pictures. See docs/DEPLOYMENT.md, "Uploaded pictures".
#   local — on the api-media volume, served by the API's nginx at APP_URL/storage
#   s3    — any S3-compatible bucket, described by the AWS_* lines below
MEDIA_DISK=local
# Only read when MEDIA_DISK=s3. The bucket is public by design: never the one
# private files go in.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS or Spaces: the bucket's region. Cloudflare R2: auto.
AWS_DEFAULT_REGION=
AWS_BUCKET=
# Empty for AWS. R2: https://<account id>.r2.cloudflarestorage.com.
# Spaces: https://<region>.digitaloceanspaces.com.
AWS_ENDPOINT=
# The address people load pictures from: a CDN, a custom domain, R2's public
# bucket URL. Required for R2, whose endpoint above is not public.
AWS_URL=
# true for MinIO and other path-style stores.
AWS_USE_PATH_STYLE_ENDPOINT=false
# private (AWS, R2: the bucket's own policy makes files readable, and both
# refuse a public ACL) or public (DigitalOcean Spaces: every file needs one).
MEDIA_VISIBILITY=private

# --- email -------------------------------------------------------------------------
# Everything this platform does ends in an email. The sending domain needs SPF
# and DKIM, or tickets arrive in spam folders.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=tickets@myfiesta.ca
MAIL_FROM_NAME=myFiesta
# An inbox a person reads. The warnings about an account being moved or payouts
# being redirected tell whoever did not do it to reply straight away, and this
# is where that reply goes. Left empty, it goes to MAIL_FROM_ADDRESS above: the
# address tickets are sent from, which is only right if somebody reads it.
MAIL_SUPPORT_ADDRESS=

# --- who runs this -----------------------------------------------------------------
# The operator's own details, shown on the site's contact, terms, privacy and
# refund pages (config/myfiesta.php). Until the name, a support inbox and one
# postal address are set, those pages say the details are still to be filled
# in — CASL and the NDPA both require a reachable operator.
# The registered legal name, not the brand.
CONTACT_COMPANY_NAME=
# Whatever it is registered under, shown as written. Optional.
CONTACT_COMPANY_NUMBER=
# Left empty, MAIL_SUPPORT_ADDRESS above.
CONTACT_SUPPORT_EMAIL=
# Requests about personal data. Left empty, the support inbox.
CONTACT_PRIVACY_EMAIL=
# Optional. Left empty, no number is shown.
CONTACT_PHONE=
# One line each; at least one.
CONTACT_ADDRESS_CA=
CONTACT_ADDRESS_NG=

# --- money -------------------------------------------------------------------------
# Stripe for CAD, Paystack for NGN. The webhook secrets are what make a paid
# order paid: without them nothing is ever fulfilled. Paystack signs its
# webhooks with PAYSTACK_SECRET_KEY, so it has no separate one.
#
# Production will not start with STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET or
# PAYSTACK_SECRET_KEY empty (php artisan app:preflight). Anywhere else, a blank
# secret means every webhook for that gateway is refused: a signature keyed
# with nothing is one anybody can make.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# --- tax and receipts --------------------------------------------------------------
# Defaults only: an administrator changes every one of these in the admin, under
# Configuration → Platform settings, and what is saved there wins. Left as they are,
# checkout charges what it always has — the organizer sells the ticket, the service
# charge is not taxed, and Quebec pays 5% GST without QST. The numbers are the
# business's own and are printed on receipts; leave one empty until it exists.
# PLATFORM_SERVICE_CHARGE_BPS=800
TAX_SELLER_OF_RECORD=organizer
TAX_ON_SERVICE_CHARGE=false
TAX_QST_ENABLED=false
TAX_QST_RATE=9.975
TAX_GST_HST_NUMBER=
TAX_QST_NUMBER=
TAX_NG_VAT_NUMBER=

# --- the move from the old platform ------------------------------------------------
# Only on the migration host, only for the cutover (docs/CUTOVER.md); take them out
# once it is signed off. The old MySQL, loaded from the dump, which never leaves that machine:
LEGACY_DB_HOST=
LEGACY_DB_PORT=3306
LEGACY_DB_DATABASE=
LEGACY_DB_USERNAME=
LEGACY_DB_PASSWORD=
# A restricted Stripe key that can only read, on the account the old platform charged through.
LEGACY_STRIPE_KEY=
# Stripe requests per second for legacy:reconcile, shared with live checkout. Never empty: 0 is unthrottled.
LEGACY_STRIPE_RATE=20

# --- texts -------------------------------------------------------------------------
# Termii for Nigerian numbers (+234), with its key, sender id and the STOP
# secret below — or Twilio, with its three.
#
# Not "log". The log driver reports every text as sent and sends none, so a
# buyer would be told nothing while the platform recorded that they were, and
# production refuses to start with it. Until a provider account exists, empty
# SMS_COUNTRIES instead: no number is then worth texting, nothing is sent and
# nothing is claimed.
SMS_DRIVER=termii
SMS_COUNTRIES=234
TERMII_API_KEY=
TERMII_SENDER_ID=myFiesta
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# The secret in the inbound webhook's path, where STOP replies arrive.
SMS_INBOUND_SECRET=

# --- watching it -------------------------------------------------------------------
# Errors go to Sentry, one project per app, each with its own DSN; empty sends
# nothing from that app. Personal details are never sent, whatever is set here
# (config/sentry.php). The release is the image tag, baked in when it is built.
# See docs/OPERATIONS.md, "Errors".
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
# production or staging: which environment an error came from.
SENTRY_ENVIRONMENT=production
# The site's and the console's own projects, stamped into their pages at start-up.
SITE_SENTRY_DSN=
CONSOLE_SENTRY_DSN=
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# --- backups -----------------------------------------------------------------------
# Nightly at 06:30 UTC (php artisan backup:run), kept 7 daily, 4 weekly, 6
# monthly. See docs/OPERATIONS.md for the restore drill.
#   volume — the api-backups volume, on this host: better than nothing, not off-site
#   s3     — any S3-compatible bucket of its own. Never the pictures bucket, which is public.
BACKUP_TARGET=volume
BACKUP_S3_KEY=
BACKUP_S3_SECRET=
BACKUP_S3_REGION=
BACKUP_S3_BUCKET=
# Empty for AWS. R2: https://<account id>.r2.cloudflarestorage.com.
BACKUP_S3_ENDPOINT=
BACKUP_S3_PATH_STYLE=false
BACKUP_S3_PREFIX=database
# What the bucket encrypts each backup with at rest: AES256 or aws:kms on AWS.
# Empty for R2, which encrypts everything already.
BACKUP_S3_SSE=
# Every backup is sealed with this before it leaves the server:
#   php artisan backup:key
# Keep a copy in the password manager, away from this server and the bucket.
# Without it no backup made with it can be opened; empty stores plain dumps.
BACKUP_ENCRYPTION_KEY=

# --- maintenance mode --------------------------------------------------------------
# `php artisan down` kept in Redis rather than a file inside one container, so it
# reaches every API container and survives them being recreated mid-restore.
APP_MAINTENANCE_DRIVER=cache
APP_MAINTENANCE_STORE=redis

# --- the ports the compose file publishes ------------------------------------------
# Behind whatever terminates TLS.
#
# The API is published on this host's loopback only, for a load balancer on
# the same host, whose connections arrive from the compose network's gateway.
# Anything else that reaches a published port through Docker's proxy — a
# visitor over IPv6, say — arrives from the gateway as well, so a public port
# with the gateway in TRUSTED_PROXIES would believe whatever any visitor
# forwarded. Set 0.0.0.0 only with the balancer on another machine and its own
# address in TRUSTED_PROXIES.
API_BIND=127.0.0.1
API_PORT=8000
SITE_PORT=4000
CONSOLE_PORT=4310
