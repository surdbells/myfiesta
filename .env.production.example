# What a deployment needs, in one file.
#
#   cp .env.production.example .env.production
#
# Read by ops/docker/compose.prod.yml: the API containers take it as their
# .env, and the site and console read the addresses out of it. Never committed
# — .dockerignore and .gitignore both keep it out, because it holds every
# credential this platform has.
#
# See docs/DEPLOYMENT.md for what runs and why.

# --- the application ------------------------------------------------------------
APP_NAME=myFiesta
APP_ENV=production
# php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.myfiesta.ca

# Where the two front ends live. The API builds links into emails from these,
# so a wrong one sends buyers somewhere that does not exist.
PUBLIC_URL=https://myfiesta.ca
CONSOLE_URL=https://console.myfiesta.ca

# Every origin that may call this API, including the two a Capacitor app
# reports. An origin missing here is a browser refusing every request with an
# error that says nothing about why.
CORS_ALLOWED_ORIGINS=https://myfiesta.ca,https://www.myfiesta.ca,https://console.myfiesta.ca,https://localhost,capacitor://localhost

# --- the addresses the front ends are told at run time -----------------------------
# The same values again, for the site and console containers. Nothing is
# compiled into either bundle, so one build serves staging and production.
API_BASE_URL=https://api.myfiesta.ca
SITE_HOSTS=myfiesta.ca,www.myfiesta.ca

# --- data --------------------------------------------------------------------------
# Postgres 17. Not negotiable: generated columns, partial unique indexes, check
# constraints and an append-only trigger on the ledger.
DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=myfiesta
DB_USERNAME=
DB_PASSWORD=

REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=

QUEUE_CONNECTION=redis
CACHE_STORE=redis
SESSION_DRIVER=redis

# Private files — identity documents, data exports. A volume that survives a
# redeploy, or object storage. Never the image.
FILESYSTEM_DISK=local

# --- email -------------------------------------------------------------------------
# Everything this platform does ends in an email. The sending domain needs SPF
# and DKIM, or tickets arrive in spam folders.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=tickets@myfiesta.ca
MAIL_FROM_NAME=myFiesta
# An inbox a person reads. The warnings about an account being moved or payouts
# being redirected tell whoever did not do it to reply straight away, and this
# is where that reply goes. Left empty, it goes to MAIL_FROM_ADDRESS above: the
# address tickets are sent from, which is only right if somebody reads it.
MAIL_SUPPORT_ADDRESS=

# --- money -------------------------------------------------------------------------
# Stripe for CAD, Paystack for NGN. The webhook secrets are what make a paid
# order paid: without them nothing is ever fulfilled.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# --- texts -------------------------------------------------------------------------
# Leave as log until an account exists: the path runs and nothing is sent.
SMS_DRIVER=log
SMS_COUNTRIES=234
TERMII_API_KEY=
TERMII_SENDER_ID=myFiesta
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# The secret in the inbound webhook's path, where STOP replies arrive.
SMS_INBOUND_SECRET=

# --- watching it -------------------------------------------------------------------
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# --- the ports the compose file publishes ------------------------------------------
# Behind whatever terminates TLS.
API_PORT=8000
SITE_PORT=4000
CONSOLE_PORT=4310
