<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 11 and older: the same answer as data_extraction_rules.xml, for the
  same reasons — nothing this app keeps is safe or useful to restore.

  With allowBackup="false" these phones back nothing up anyway. This file is
  here so that the answer does not depend on that one attribute: if it is ever
  turned back on, the token and the tickets still stay out.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
