APP_NAME=myFiesta
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=15432
DB_DATABASE=myfiesta_dev
DB_USERNAME=postgres
DB_PASSWORD=postgres

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=56379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Origins allowed to call this API from a browser. Comma-separated, exact.
# Every client that may call this API. The three dev servers, and the two
# origins a Capacitor app reports — https://localhost on Android, and
# capacitor://localhost on iOS. An origin missing here is a browser refusing
# every request with an error that says nothing about why.
CORS_ALLOWED_ORIGINS=http://localhost:4310,http://127.0.0.1:4310,http://localhost:4320,http://127.0.0.1:4320,http://localhost:4330,http://127.0.0.1:4330,https://localhost,capacitor://localhost

CONSOLE_URL=http://localhost:4310
PUBLIC_URL=http://localhost:4320

# Text messages. With no driver named, nothing is sent anywhere: the log
# driver writes what it would have sent, which is what lets the whole path be
# built and tested before an account exists. Termii covers Nigeria, Twilio
# the rest; SMS_COUNTRIES is the dialling codes worth the cost of a text.
SMS_DRIVER=log
SMS_COUNTRIES=234
TERMII_API_KEY=
TERMII_SENDER_ID=myFiesta
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# The secret in the inbound webhook's path, where STOP replies arrive.
SMS_INBOUND_SECRET=
