APP_NAME=myFiesta
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=15432
DB_DATABASE=myfiesta_dev
DB_USERNAME=postgres
DB_PASSWORD=postgres

# The old platform's MySQL, read only by legacy:import during the cutover
# (config/database.php, `legacy`; docs/CUTOVER.md). The dump never leaves its machine.
LEGACY_DB_HOST=127.0.0.1
LEGACY_DB_PORT=3306
LEGACY_DB_DATABASE=sql_myfiesta_ca
LEGACY_DB_USERNAME=root
LEGACY_DB_PASSWORD=
# A restricted, read-only Stripe key on the old platform's account, for legacy:reconcile. Empty uses STRIPE_SECRET_KEY.
LEGACY_STRIPE_KEY=
# Stripe requests per second legacy:reconcile may make; the limit is shared with live checkout, so never empty.
LEGACY_STRIPE_RATE=20

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Admin staff stay signed in until they sign out (see config/session.php).
# Minutes a staff session may sit idle, and how long "keep me signed in" lasts.
# SESSION_STAFF_LIFETIME=43200
# SESSION_STAFF_REMEMBER=576000
# Defaults to true when APP_ENV=production.
# SESSION_SECURE_COOKIE=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=56379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# The inbox a person reads. Emails about an account being moved or payouts
# being redirected tell somebody who did not do it to reply straight away, and
# this is the Reply-To on them. Unset, replies go to MAIL_FROM_ADDRESS — so if
# this stays empty, somebody has to read that one.
MAIL_SUPPORT_ADDRESS=

# Uploaded pictures: local (storage/app/public, after `php artisan
# storage:link`) or s3 (any S3-compatible bucket, from the AWS_* lines below).
# See docs/DEPLOYMENT.md, "Uploaded pictures".
MEDIA_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false
MEDIA_VISIBILITY=private

# Who runs the platform, for the site's contact and legal pages
# (config/myfiesta.php). Left empty, the pages say they are still to be filled in.
CONTACT_COMPANY_NAME=
CONTACT_COMPANY_NUMBER=
CONTACT_SUPPORT_EMAIL=
CONTACT_PRIVACY_EMAIL=
CONTACT_PHONE=
CONTACT_ADDRESS_CA=
CONTACT_ADDRESS_NG=

VITE_APP_NAME="${APP_NAME}"

# Origins allowed to call this API from a browser. Comma-separated, exact.
# Every client that may call this API. The three dev servers, and the two
# origins a Capacitor app reports — https://localhost on Android, and
# capacitor://localhost on iOS. An origin missing here is a browser refusing
# every request with an error that says nothing about why.
CORS_ALLOWED_ORIGINS=http://localhost:4310,http://127.0.0.1:4310,http://localhost:4320,http://127.0.0.1:4320,http://localhost:4330,http://127.0.0.1:4330,https://localhost,capacitor://localhost

CONSOLE_URL=http://localhost:4310
PUBLIC_URL=http://localhost:4320

# Text messages. With no driver named, nothing is sent anywhere: the log
# driver writes what it would have sent, which is what lets the whole path be
# built and tested before an account exists. Termii covers Nigeria, Twilio
# the rest; SMS_COUNTRIES is the dialling codes worth the cost of a text.
SMS_DRIVER=log
SMS_COUNTRIES=234
TERMII_API_KEY=
TERMII_SENDER_ID=myFiesta
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# The secret in the inbound webhook's path, where STOP replies arrive.
SMS_INBOUND_SECRET=
